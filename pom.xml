<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent Spring Boot pour bénéficier de la gestion des dépendances -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>org.makalisio</groupId>
    <artifactId>gsbatch</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <name>gsbatch</name>
    <description>Generic Spring Batch ingestion core framework</description>
    <packaging>jar</packaging>
    <url>https://github.com/makalisio/gsbatch</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versions des dépendances

             RÈGLE : une propriété gérée par le BOM Spring Boot ne se surcharge
             ici QUE vers le haut, quand le BOM est en retard sur un correctif
             de sécurité — et l'entrée est retirée dès que le BOM rattrape.
             Une surcharge vers le bas rétrograde le composant sous la version
             corrigée livrée par le BOM et réintroduit des CVE (c'est ce qui
             s'était produit après la montée du parent de 3.4.7 à 3.5.16 :
             spring-framework, jackson, logback et snakeyaml étaient figés à
             leurs versions de l'époque). -->
        <!-- GHSA-wwpq-f5c3-7hvx / CVE-2026-40973: Spring Boot predictable temp directory (patch: 3.5.14) -->
        <spring.boot.version>3.5.16</spring.boot.version>
        <!-- CVE-2026-54515: @JsonIgnoreProperties contourné via ACCEPT_CASE_INSENSITIVE_PROPERTIES.
             Boot 3.5.16 livre 2.21.4, encore vulnérable (patch: 2.21.5).
             À retirer quand le BOM Boot fournira >= 2.21.5. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <!-- CVE-2026-13006: injection d'expression via les éléments <if> évalués par Janino
             (contournement incomplet de CVE-2025-11226, denylist contournable jusqu'en 1.5.36).
             Boot 3.5.16 livre 1.5.34. Non exploitable ici (Janino absent du classpath) mais
             la version reste signalée. À retirer quand le BOM Boot fournira >= 1.5.37. -->
        <logback.version>1.5.38</logback.version>
        <lombok.version>1.18.46</lombok.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- CVE-2024-57699: json-smart DoS via stack exhaustion (transitive via json-path) -->
            <dependency>
                <groupId>net.minidev</groupId>
                <artifactId>json-smart</artifactId>
                <version>2.5.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Batch (inclut déjà spring-batch-infrastructure) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
        </dependency>

        <!-- Configuration processor (pour @ConfigurationProperties metadata) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok (réduit le boilerplate) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- YAML parser (version gérée par le BOM Spring Boot) -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- Validation API (recommandé pour la validation des configurations) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 en mémoire pour les tests d'intégration du job générique -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 (inclus dans spring-boot-starter-test mais explicite pour clarté) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Mockito (pour les tests unitaires) -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ (assertions fluides pour les tests) -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>[3.27.7,)</version>
            <scope>test</scope>
        </dependency>

        <!-- Validation du schema JSON des YAML d'ingestion (test uniquement) -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>


        <!-- JSON Path for extracting data from nested JSON responses
             (version gérée par le BOM Spring Boot) -->
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
        </dependency>

        <!-- Jackson for JSON serialization of nested objects (Map/List → valid JSON string) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Spring Web (RestTemplate support) -->
        <!-- Already included transitively via spring-boot-starter, but declared explicitly -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Spring Retry for transient HTTP error handling -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!-- Micrometer for operational metrics (items read/written, HTTP call latency).
             Falls back to an in-memory SimpleMeterRegistry when the consumer app has no
             MeterRegistry bean of its own (e.g. no Actuator), so it never breaks startup. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Spring Boot - repackaging désactivé car c'est une bibliothèque -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Plugin Maven Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring.boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Plugin Surefire pour les tests unitaires -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Plugin Failsafe pour les tests d'intégration -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

            <!-- Plugin pour vérifier les versions des dépendances -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.16.2</version>
            </plugin>

            <!-- Plugin pour générer les sources (utile pour les bibliothèques) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin pour générer la Javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <!-- doclint all,-missing,-reference : tous les checks SAUF @param/@return
                         manquants et les références - les {@link Xxx#getYyy()} pointent vers
                         des getters générés par Lombok, invisibles pour javadoc -->
                    <doclint>all,-missing,-reference</doclint>
                    <!-- Encodage explicite pour éviter les erreurs sur les caractères accentués -->
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <docencoding>UTF-8</docencoding>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profils pour différents environnements -->
    <profiles>
        <!-- Profil de développement -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
        </profile>

        <!-- Profil de production -->
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-no-snapshots</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseDeps>
                                            <message>No Snapshots Allowed in production!</message>
                                        </requireReleaseDeps>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profil pour la couverture de code -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.11</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- Repositories (optionnel, décommenter si besoin) -->
    <!--
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    -->

    <!-- Publication des releases sur GitHub Packages.
         Le workflow .github/workflows/release.yml se déclenche sur un tag vX.Y.Z,
         injecte la version depuis le tag (versions:set) et exécute mvn deploy.
         Le pom garde une version de développement -SNAPSHOT entre les releases. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - makalisio/gsbatch</name>
            <url>https://maven.pkg.github.com/makalisio/gsbatch</url>
        </repository>
    </distributionManagement>

</project>
